{
    "name": "bedrock-workspace",
    "version": "1.0.0",
    "description": "JavaScript and TypeScript workspace for Minecraft Bedrock development",
    "author": "aKiNaRi",
    "license": "MIT",
    "private": true,
    "workspaces": {
        "packages": [
            "libraries/debug/debugAPI/v0.1.5"
        ]
    },
    "devDependencies": {
        "bun-plugin-dts": "^0.4.0",
        "bun-types": "^1.3.13",
        "chalk": "^4.1.2",
        "degit": "^2.8.4",
        "inquirer": "^8.2.6",
        "prettier": "^3.6.2",
        "zip-lib": "^1.0.6",
        "json-schema-to-typescript": "^15.0.4",
        "jsonc": "^2.0.0"
    },
    "dependencies": {
        "@minecraft/debug-utilities": "1.0.0-beta.1.26.10-stable",
        "@minecraft/math": "^2.3.0",
        "@minecraft/server": "^2.6.0",
        "@minecraft/server-ui": "^2.0.0",
        "@minecraft/vanilla-data": "^1.21.90"
    },
    "scripts": {
        "debug": "$env:REAL_CWD=$PWD; bun run ./workspace/task-runner.ts debug",
        
        // "create-symlink": "cross-env \"REAL_CWD=%CD%\" just-scripts create-symlink",
        // "mcaddon": "cross-env \"REAL_CWD=%CD%\" just-scripts mcaddon",
        // "new-project": "just-scripts new-project",
        // "update-workspace": "cross-env \"REAL_CWD=%CD%\" just-scripts update-workspace",
        // "update-bedrock-workspace": "just-scripts update-bedrock-workspace",
        // "analyze": "cross-env \"REAL_CWD=%CD%\" just-scripts analyze",
        // "backup": "cross-env \"REAL_CWD=%CD%\" just-scripts backup",
        // "update-version": "cross-env \"REAL_CWD=%CD%\" just-scripts update-version",
        // "generate-uuids": "cross-env \"REAL_CWD=%CD%\" just-scripts generate-uuids",

        "list-projects": "$env:REAL_CWD=$PWD; bun run ./workspace/task-runner.ts list-projects",
        "open-mc-folder": "$env:REAL_CWD=$PWD; bun run ./workspace/task-runner.ts open-mc-folder",
        "clone-project": "$env:REAL_CWD=$PWD; bun run ./workspace/task-runner.ts clone-project",
        "delete-project": "$env:REAL_CWD=$PWD; bun run ./workspace/task-runner.ts delete-project",
        "rename-project": "$env:REAL_CWD=$PWD; bun run ./workspace/task-runner.ts rename-project",
        "open-project": "$env:REAL_CWD=$PWD; bun run ./workspace/task-runner.ts open-project",
        "list-development-projects": "$env:REAL_CWD=$PWD; bun run ./workspace/task-runner.ts list-development-projects",
        "import-development-projects": "$env:REAL_CWD=$PWD; bun run ./workspace/task-runner.ts import-development-projects",
        "open-workspace": "$env:REAL_CWD=$PWD; bun run ./workspace/task-runner.ts open-workspace",

        "enablemcloopback": "CheckNetIsolation.exe LoopbackExempt -a -p=S-1-15-2-1958404141-86561845-1752920682-3514627264-368642714-62675701-733520436",
        "enablemcpreviewloopback": "CheckNetIsolation.exe LoopbackExempt -a -p=S-1-15-2-424268864-5579737-879501358-346833251-474568803-887069379-4040235476"
    },
    "keywords": ["minecraft", "bedrock", "typescript", "javascript", "workspace", "development"],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/ackinari/VSCode-Workspace.git"
    }
